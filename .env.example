# ========================================================
# TRAVEL BUDDY - FULL STACK MERN ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/travel_buddy
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/travel_buddy?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/travel_buddy

# JWT Secret Key for Bearer Authentication
JWT_SECRET=travel_buddy_super_secret_jwt_key_2026

# Client Origin (CORS whitelist)
CLIENT_URL=http://localhost:5173
